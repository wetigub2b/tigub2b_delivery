# Shared environment configuration for the delivery platform.
# Copy this file to `.env` at the repository root and adjust values for your environment.

# === Database (SQLite default) ===
# Local SQLite file. Tables are created + seeded via: cd bff && ./../bff/.venv/bin/python init_sqlite.py
DATABASE_URL=sqlite+aiosqlite:///./data/delivery.db
# Optional: use MySQL instead (legacy). Uncomment to override SQLite.
# DATABASE_URL=mysql+asyncmy://tigu_user:tigu_pass@127.0.0.1:3306/tigu_b2b
# Legacy MySQL connection parts (only used when DATABASE_URL is MySQL):
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tigu_b2b
MYSQL_USER=tigu_user
MYSQL_PASSWORD=tigu_pass

# === Redis (optional) ===
# If unreachable, the BFF falls back to in-memory refresh tokens + driver locations.
REDIS_URL=redis://127.0.0.1:6379/0

# === FastAPI/BFF Settings ===
APP_NAME="Tigu Delivery BFF"
API_V1_PREFIX=/api
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
GOOGLE_MAPS_API_KEY=your-google-maps-key
BFF_HOST=0.0.0.0
BFF_PORT=9000
BFF_WORKERS=1
PYTHON_BIN=python3

# === Frontend (Vite) ===
VITE_API_URL=http://localhost:9000/api
VITE_GOOGLE_MAPS_KEY=your-google-maps-key
VITE_MAPBOX_TOKEN=your-mapbox-token
WEB_ROOT=/var/www/html/delivery
